# Optional: ScrapeGraphAI API key (primary extraction)
SCRAPEGRAPH_API_KEY=

# Optional: OpenAI fallback extraction + enrichment
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional pipeline controls
MAX_URLS=100
REQUEST_DELAY=0.4
TIMEOUT_SECONDS=30
USE_PLAYWRIGHT=false
ALLOWED_REGIONS=europe,remote
ROLE_KEYWORDS=ml,ai,data,machine learning
EXCLUDE_SENIORITY=staff,principal,lead,head
